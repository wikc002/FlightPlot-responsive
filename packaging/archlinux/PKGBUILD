# Maintainer: wikc002
pkgname=flightplot-responsive-git
pkgver=0.5.8
pkgrel=1
pkgdesc="PX4 and ArduPilot flight log plotter"
arch=(any)
url="https://github.com/wikc002/FlightPlot-responsive"
license=('BSD-3-Clause')
depends=('java-runtime>=8')
makedepends=('apache-ant' 'git')
provides=('flightplot')
conflicts=('flightplot')
source=('git+https://github.com/wikc002/FlightPlot-responsive.git')
sha256sums=('SKIP')

build() {
  cd "$srcdir/FlightPlot-responsive"
  ant clean all
}

package() {
  cd "$srcdir/FlightPlot-responsive"
  install -Dm644 out/production/flightplot.jar \
    "$pkgdir/usr/share/java/flightplot/flightplot.jar"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 packaging/ubuntu/FlightPlot/usr/share/icons/64x64/apps/flightplot.png \
    "$pkgdir/usr/share/icons/hicolor/64x64/apps/flightplot.png"
  install -Dm644 packaging/ubuntu/FlightPlot/usr/share/applications/flightplot.desktop \
    "$pkgdir/usr/share/applications/flightplot.desktop"
  install -d "$pkgdir/usr/bin"
  printf '%s\n' '#!/bin/sh' 'exec java -jar /usr/share/java/flightplot/flightplot.jar "$@"' \
    > "$pkgdir/usr/bin/flightplot"
  chmod 755 "$pkgdir/usr/bin/flightplot"
}

pkgver() {
  cd "$srcdir/FlightPlot-responsive"
  printf "0.5.8.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}
